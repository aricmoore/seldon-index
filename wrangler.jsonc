{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seldon-index",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-31",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "AII_KV", "id": "9ae990aec2c3462781beec99769829bf" }
  ],
  "ratelimits": [
    { "name": "HEADLINE_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "FELLOW_WATCH_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
